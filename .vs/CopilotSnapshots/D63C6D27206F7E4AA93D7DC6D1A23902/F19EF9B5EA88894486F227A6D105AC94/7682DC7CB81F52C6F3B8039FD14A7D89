using System;
using System.Collections.Generic;

namespace MIPVizsga
{
    /// <summary>
    /// Utility class for generating test datasets.
    /// </summary>
    public class DatasetGenerator
    {
        /// <summary>
        /// Generates at least 100 delivery records programmatically.
        /// Distribution: 30+ Priority 1, 30+ Priority 2, 30+ Priority 3, remaining any valid priority.
        /// </summary>
        public static List<Delivery> GenerateDataset()
        {
            var deliveries = new List<Delivery>();
            int id = 1;

            // Generate 30 Priority 1 deliveries (RegularDelivery)
            for (int i = 0; i < 30; i++)
            {
                deliveries.Add(new RegularDelivery
                {
                    Id = id++,
                    Recipient = $"Recipient_P1_{i + 1}",
                    Priority = 1,
                    Status = "Pending"
                });
            }

            // Generate 30 Priority 2 deliveries (RegularDelivery)
            for (int i = 0; i < 30; i++)
            {
                deliveries.Add(new RegularDelivery
                {
                    Id = id++,
                    Recipient = $"Recipient_P2_{i + 1}",
                    Priority = 2,
                    Status = "Pending"
                });
            }

            // Generate 30 Priority 3 deliveries (ExpressDelivery)
            for (int i = 0; i < 30; i++)
            {
                deliveries.Add(new ExpressDelivery
                {
                    Id = id++,
                    Recipient = $"Recipient_P3_{i + 1}",
                    Priority = 3,
                    Status = "Pending"
                });
            }

            // Generate 20 additional deliveries with mixed priorities to reach 110 total
            int[] priorityDistribution = { 1, 2, 3, 1, 2, 3, 1, 2, 3, 3, 1, 2, 3, 1, 2, 3, 1, 2, 3, 1 };
            for (int i = 0; i < 20; i++)
            {
                int priority = priorityDistribution[i];
                Delivery delivery;

                if (priority == 3)
                {
                    delivery = new ExpressDelivery
                    {
                        Id = id++,
                        Recipient = $"Recipient_Extra_{i + 1}",
                        Priority = 3,
                        Status = "Pending"
                    };
                }
                else
                {
                    delivery = new RegularDelivery
                    {
                        Id = id++,
                        Recipient = $"Recipient_Extra_{i + 1}",
                        Priority = priority,
                        Status = "Pending"
                    };
                }

                deliveries.Add(delivery);
            }

            return deliveries;
        }
    }
}
